# 지도 화면에서 사용하는 Kakao 브라우저 공개 JavaScript 키입니다.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Google Maps JavaScript API용 공개 키입니다.
# 사용하는 앱 주소를 Google Cloud의 웹사이트 제한에 추가합니다.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Places API (New)용 서버 키입니다. Pages 런타임에 등록합니다.
GOOGLE_PLACES_API_KEY=

# Gemini의 장소 요약용 서버 키입니다. Pages 런타임에 등록합니다.
GEMINIAI_API_KEY=

# Odyssey API 주소입니다. 비우면 운영 API를 씁니다. 값이 있으면 https 주소여야 합니다.
# 브라우저 빌드용 공개 값입니다. 스테이징은 스테이징 BE 주소로 빌드합니다.
NEXT_PUBLIC_ODYSSEY_API_BASE_URL=

# 사진·요약 서버가 장소를 조회할 Odyssey API 주소입니다. Pages 런타임과 Next 개발 서버에 같은 이름으로 등록합니다.
# 비우면 NEXT_PUBLIC_ODYSSEY_API_BASE_URL, 그것도 없으면 운영 API를 씁니다.
ODYSSEY_API_BASE_URL=

# 사진·요약 서버를 허용할 호스트입니다. 쉼표로 구분하고 미리보기는 *.프로젝트.pages.dev 형식을 씁니다.
# 비우면 local.hrxlou.com과 localhost만 허용합니다.
PLACE_ALLOWED_HOSTS=
